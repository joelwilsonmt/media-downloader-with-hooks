# Server Configuration
PORT=3000

# TikTok API Credentials
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Hooks Configuration
ENABLE_TIKTOK=true
ENABLE_SLACK=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GENERIC_WEBHOOK_URL=https://n8n.your-server.com/...

# Downloads
# Parallel yt-dlp processes; the rest wait in the queue.
MAX_CONCURRENT_JOBS=2
# How long a "This device" file waits on the server for the browser to fetch it.
DEVICE_FILE_TTL_MINUTES=60
