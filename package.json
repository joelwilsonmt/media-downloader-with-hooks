{
  "name": "media-downloader-with-hooks",
  "version": "1.0.0",
  "description": "Download media from YouTube, SoundCloud, Spotify and more into a Jellyfin library or straight to your device",
  "main": "src/server.ts",
  "scripts": {
    "prestart": "bun src/setup-binaries.ts",
    "start": "bun src/server.ts",
    "dev": "bun src/setup-binaries.ts && concurrently -k -n api,web -c yellow,cyan \"bun --watch src/server.ts\" \"vite --host\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint --max-warnings 0 src shared web/src",
    "test": "vitest run",
    "format": "prettier --write src/*.ts shared web/src *.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "axios": "^1.20.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "spotify-url-info": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/bun": "^1.4.3",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.59.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
